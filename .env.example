# Phalanx runtime configuration
#
# Phalanx runs autonomous blue-team agent swarms with zero hardcoded playbooks.
# You can configure models and API keys either via this environment file or
# dynamically in the web UI under Model Settings (/settings).

# -----------------------------------------------------------------------------
# Execution Mode & Provider
# -----------------------------------------------------------------------------
# PHALANX_MODE:
#   replay - Deterministic director driving real A2A transport and A2UI surfaces (offline, zero API cost)
#   live   - Real multi-agent sessions calling LLM providers
PHALANX_MODE=replay

# PHALANX_PROVIDER:
#   gemini    - Google Gemini (Gemini 3.1 Pro for commanders, 3.8 Flash for specialists)
#   anthropic - Anthropic Claude (Claude Sonnet 5 for commanders, Haiku 4.5 for specialists)
#   openai    - OpenAI (GPT-5 for commanders, GPT-5 mini for specialists)
#   replay    - Deterministic replay director
PHALANX_PROVIDER=replay

# -----------------------------------------------------------------------------
# Provider API Credentials (Optional for replay mode)
# -----------------------------------------------------------------------------
# Google Gemini API key
GEMINI_API_KEY=

# Anthropic Claude API key (or ANTHROPIC_AUTH_TOKEN)
ANTHROPIC_API_KEY=

# OpenAI API key
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Server Network & Timing
# -----------------------------------------------------------------------------
# Port to bind (0.0.0.0:<PORT>). Accessible locally and across LAN/VPN.
PHALANX_PORT=8095

# Wall-clock pacing for the simulated estate in milliseconds (default: 1500)
PHALANX_TICK_MS=1500

# Directory for isolated loopback range lab logs and telemetry
# PHALANX_RANGE_DIR=~/.phalanx-range
